# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite database and instance directory
instance/
*.db
*.sqlite3

# Virtual environments
venv/
.venv/
env/

# Uploaded media (keep folder structure with .gitkeep)
static/uploads/receipts/*
!static/uploads/receipts/.gitkeep
static/uploads/workers/*
!static/uploads/workers/.gitkeep

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary & system files
.DS_Store
Thumbs.db
*.log
